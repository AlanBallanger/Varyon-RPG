Group #VaryonRpgRoot {
  LayoutMode: Full;

  Group {
    LayoutMode: Middle;

    Group {
      Anchor: (Width: 540, Height: 290);
      Background: (Color: #0b0f14);
      LayoutMode: Top;

      Group {
        Anchor: (Height: 48);
        Background: (Color: #06090c);
        LayoutMode: Left;

        Label #PanelTitle {
          FlexWeight: 1;
          Style: (FontSize: 16, TextColor: #f2c14b, RenderBold: true, VerticalAlignment: Center, Wrap: false);
          Padding: (Left: 20);
          Text: "Varyon RPG";
        }

        Button #CloseBtn {
          Anchor: (Width: 48, Top: 0, Bottom: 0);
          Style: ButtonStyle(
            Default: (Background: (Color: #1c2535)),
            Hovered: (Background: (Color: #2a3a50)),
            Pressed: (Background: (Color: #0f1820))
          );

          Label {
            Style: (FontSize: 14, TextColor: #ffffff, RenderBold: true, Alignment: Center);
            Text: "x";
          }
        }
      }

      Group { Anchor: (Height: 1); Background: (Color: #1e2530); }

      Group {
        Anchor: (Height: 104);
        LayoutMode: Left;
        Padding: (Full: 12, Left: 20, Right: 20);

        Group #BlockOnline {
          FlexWeight: 1;
          Background: (Color: #0e1420);
          LayoutMode: Top;
          Padding: (Full: 8);

          Label {
            Anchor: (Height: 18);
            Style: (FontSize: 11, TextColor: #96a9be, RenderUppercase: true, RenderBold: true, Alignment: Center, Wrap: false);
            Text: "En ligne";
          }

          Label #OnlineCount {
            Anchor: (Height: 32);
            Style: (FontSize: 22, TextColor: #f2c14b, RenderBold: true, Alignment: Center, Wrap: false);
            Text: "-";
          }
        }

        Group { Anchor: (Width: 12); }

        Group {
          FlexWeight: 1;
          Background: (Color: #0e1420);
          LayoutMode: Top;
          Padding: (Full: 8);

          Label {
            Anchor: (Height: 18);
            Style: (FontSize: 11, TextColor: #96a9be, RenderUppercase: true, RenderBold: true, Alignment: Center, Wrap: false);
            Text: "Metiers";
          }

          Label #JobCount {
            Anchor: (Height: 32);
            Style: (FontSize: 22, TextColor: #4aa3ff, RenderBold: true, Alignment: Center, Wrap: false);
            Text: "8";
          }
        }

        Group { Anchor: (Width: 12); }

        Group {
          FlexWeight: 1;
          Background: (Color: #0e1420);
          LayoutMode: Top;
          Padding: (Full: 8);

          Label {
            Anchor: (Height: 18);
            Style: (FontSize: 11, TextColor: #96a9be, RenderUppercase: true, RenderBold: true, Alignment: Center, Wrap: false);
            Text: "Version";
          }

          Label #ModVersion {
            Anchor: (Height: 32);
            Style: (FontSize: 16, TextColor: #45ff67, RenderBold: true, Alignment: Center, Wrap: false);
            Text: "1.0.0";
          }
        }
      }

      Group { Anchor: (Height: 1); Background: (Color: #1e2530); }

      Group {
        Anchor: (Height: 52);
        LayoutMode: Left;
        Padding: (Left: 20, Top: 8, Bottom: 8);

        Button #ReloadBtn {
          Anchor: (Width: 140, Top: 0, Bottom: 0);
          Style: ButtonStyle(
            Default: (Background: (Color: #1c2535)),
            Hovered: (Background: (Color: #2a3a50)),
            Pressed: (Background: (Color: #0f1820))
          );

          Label {
            Style: (FontSize: 13, TextColor: #96a9be, RenderBold: true, Alignment: Center);
            Text: "Recharger";
          }
        }
      }
    }
  }
}