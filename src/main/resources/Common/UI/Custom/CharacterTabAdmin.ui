$C = "Common.ui";

@AdminButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  ),
  Sounds: $C.@ButtonSounds
);

@AdminDestructiveButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Destructive.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Destructive_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Destructive_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  ),
  Sounds: $C.@ButtonSounds
);

@AdminLabelStyle = (
  FontSize: 12,
  TextColor: #C8BEB0,
  VerticalAlignment: Center
);

@AdminSectionTitleStyle = (
  FontSize: 13,
  TextColor: #C8A96E,
  RenderBold: true,
  RenderUppercase: true,
  VerticalAlignment: Center
);

@AdminValueStyle = (
  FontSize: 13,
  TextColor: #F2E8D8,
  RenderBold: true,
  VerticalAlignment: Center
);

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;
  Padding: (Full: 16);

  Group {
    Anchor: (Left: 0, Right: 0, Height: 36);
    LayoutMode: Left;

    Label {
      Anchor: (Height: 36);
      Style: @AdminLabelStyle;
      Text: "Joueur cible :";
    }

    Group { Anchor: (Width: 10); }

    Button #AdminPlayerPrev {
      Anchor: (Width: 32, Height: 30);
      Style: @AdminButtonStyle;
      LayoutMode: Middle;
      Label { Style: (FontSize: 14, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "<"; }
    }

    Group { Anchor: (Width: 6); }

    Group {
      Anchor: (Width: 200, Height: 30);
      LayoutMode: Full;
      Background: #000000(0.30);

      Label #AdminTargetName {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
        Text: "—";
      }
    }

    Group { Anchor: (Width: 6); }

    Button #AdminPlayerNext {
      Anchor: (Width: 32, Height: 30);
      Style: @AdminButtonStyle;
      LayoutMode: Middle;
      Label { Style: (FontSize: 14, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ">"; }
    }

    Group { Anchor: (Width: 10); }

    Button #AdminPlayerSelf {
      Anchor: (Width: 60, Height: 30);
      Style: @AdminButtonStyle;
      LayoutMode: Middle;
      Label { Style: (FontSize: 11, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "MOI"; }
    }

    Group { Anchor: (Width: 10); }

    Label #AdminPlayerCount {
      Anchor: (Height: 36);
      Style: (FontSize: 11, TextColor: #787060, VerticalAlignment: Center);
      Text: "";
    }
  }

  Group { Anchor: (Height: 14); }

  Group {
    Anchor: (Left: 0, Right: 0);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 520);
      LayoutMode: Top;

      Group {
        Anchor: (Left: 0, Right: 0);
        LayoutMode: Top;
        Padding: (Full: 12);
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

        Group {
          Anchor: (Left: 0, Right: 0, Height: 28);
          LayoutMode: Left;

          Label {
            Anchor: (Height: 28);
            Style: @AdminSectionTitleStyle;
            Text: "Métier :";
          }

          Group { Anchor: (Width: 10); }

          Button #AdminProfPrev {
            Anchor: (Width: 28, Height: 26);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "<"; }
          }

          Group { Anchor: (Width: 8); }

          Label #AdminProfName {
            Anchor: (Width: 120, Height: 28);
            Style: (FontSize: 14, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "—";
          }

          Group { Anchor: (Width: 8); }

          Button #AdminProfNext {
            Anchor: (Width: 28, Height: 26);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 13, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ">"; }
          }

          Group { Anchor: (Width: 16); }

          Label {
            Anchor: (Height: 28);
            Style: @AdminLabelStyle;
            Text: "Niveau :";
          }

          Group { Anchor: (Width: 6); }

          Label #AdminProfLevel {
            Anchor: (Height: 28);
            Style: @AdminValueStyle;
            Text: "—";
          }

          Group { Anchor: (Width: 12); }

          Label {
            Anchor: (Height: 28);
            Style: @AdminLabelStyle;
            Text: "XP :";
          }

          Group { Anchor: (Width: 6); }

          Label #AdminProfXp {
            Anchor: (Height: 28);
            Style: @AdminValueStyle;
            Text: "—";
          }
        }

        Group { Anchor: (Height: 10); }

        Label {
          Anchor: (Left: 0, Right: 0, Height: 18);
          Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center);
          Text: "Ajouter XP";
        }

        Group { Anchor: (Height: 4); }

        Group {
          Anchor: (Left: 0, Right: 0, Height: 30);
          LayoutMode: Left;

          Button #AdminXp100 {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+100"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminXp1k {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+1K"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminXp5k {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+5K"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminXp10k {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+10K"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminXp50k {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+50K"; }
          }
        }

        Group { Anchor: (Height: 10); }

        Label {
          Anchor: (Left: 0, Right: 0, Height: 18);
          Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center);
          Text: "Niveau";
        }

        Group { Anchor: (Height: 4); }

        Group {
          Anchor: (Left: 0, Right: 0, Height: 30);
          LayoutMode: Left;

          Button #AdminLvlMinus5 {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "−5"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminLvlMinus1 {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "−1"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminLvlPlus1 {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+1"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminLvlPlus5 {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "+5"; }
          }

          Group { Anchor: (Width: 6); }

          Button #AdminLvlMax {
            Anchor: (Width: 68, Height: 30);
            Style: @AdminButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #D4AF37, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "MAX"; }
          }
        }

        Group { Anchor: (Height: 10); }

        Label {
          Anchor: (Left: 0, Right: 0, Height: 18);
          Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center);
          Text: "Actions";
        }

        Group { Anchor: (Height: 4); }

        Group {
          Anchor: (Left: 0, Right: 0, Height: 30);
          LayoutMode: Left;

          Button #AdminResetTalents {
            Anchor: (Width: 160, Height: 30);
            Style: @AdminDestructiveButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Reset talents (métier)"; }
          }

          Group { Anchor: (Width: 10); }

          Button #AdminResetAll {
            Anchor: (Width: 160, Height: 30);
            Style: @AdminDestructiveButtonStyle;
            LayoutMode: Middle;
            Label { Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Reset complet"; }
          }
        }
      }

      Group { Anchor: (Height: 12); }

      Label #AdminFeedback {
        Anchor: (Left: 0, Right: 0, Height: 20);
        Style: (FontSize: 12, TextColor: #6BCB7A, HorizontalAlignment: Start, VerticalAlignment: Center);
        Text: "";
        Visible: false;
      }
    }

    Group { Anchor: (Width: 16); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 12);
      Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

      Label {
        Anchor: (Left: 0, Right: 0, Height: 18);
        Style: (FontSize: 11, TextColor: #787060, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center);
        Text: "Stats joueur";
      }

      Group { Anchor: (Height: 8); }

      Group #AdminStatsContainer {
        Anchor: (Left: 0, Right: 0);
        LayoutMode: Top;
      }
    }
  }
}
