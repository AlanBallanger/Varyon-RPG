// Skin aligné sur /vp (job_var) : fond Common/ContainerFullPatch + lisibilité sur fond sombre.
$C = "Common.ui";

@FubsysRpgInk = #E8DCC8;
@FubsysRpgInkStrong = #F2E8D8;
@FubsysRpgInkMuted = #C8BEB0;
@FubsysRpgInkFaint = #A89E90;
@FubsysRpgLeatherBg = #000000(0.22);
@FubsysRpgPanelShade = #000000(0.32);
@FubsysRpgCardShade = #000000(0.26);
@FubsysRpgGold = #D4AF37(0.92);
@FubsysRpgGoldSoft = #D4AF37(0.74);
@FubsysRpgGoldHighlight = #F7E6A5(0.62);
@FubsysRpgGoldShadow = #1A1612(0.55);
@FubsysRpgActiveGreen = #6BCB7A(0.95);
@FubsysRpgAging = #8A7A5A(0.22);
@FubsysRpgParchmentMottle = #FFFFFF(0.03);
@FubsysRpgGrainLight = #FFFFFF(0.02);
@FubsysRpgGrainDark = #000000(0.12);
@FubsysRpgEdge1 = #FFFFFF(0.05);
@FubsysRpgEdge2 = #FFFFFF(0.03);
@FubsysRpgEdge3 = #000000(0.20);
@FubsysRpgDivider = #E8DCC8(0.16);
@FubsysRpgDividerSoft = #E8DCC8(0.10);
@FubsysRpgBackdrop = #000000(0.42);
@FubsysRpgSelectedButtonFill = #D4AF37(0.38);
@FubsysRpgStatusPillBg = #000000(0.40);
@FubsysRpgStatusPillEdge = #D4AF37(0.35);
// Skill tree lighting is now driven by dedicated glow textures (see SkillEdgeGlow.png / SkillNodeGlow.png).
// Keep these as a fallback tint for any remaining solid-color glow elements.
@FubsysRpgSkillTreeEdgeGlow = #D4AF37(0.62);
@FubsysRpgSkillTreeNodeGlow = #D4AF37(0.18);

@HeadingStyle = (
  FontSize: 24,
  TextColor: @FubsysRpgInk,
  RenderBold: true
);

@SubHeadingStyle = (
  FontSize: 18,
  TextColor: @FubsysRpgInkStrong,
  RenderBold: true
);

@MetaStyle = (
  FontSize: 16,
  TextColor: @FubsysRpgInkMuted
);

@SectionTitleStyle = (
  FontSize: 16,
  TextColor: #C8A96E,
  RenderUppercase: true,
  RenderBold: true
);

@StatLabelStyle = (
  FontSize: 16,
  TextColor: #B8A88C,
  RenderUppercase: true
);

@ReadableStatLabelStyle = (
  ...@StatLabelStyle,
  RenderUppercase: false
);

@StatValueStyle = (
  FontSize: 18,
  TextColor: @FubsysRpgInkStrong,
  RenderBold: true
);

@PlusButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  )
);

@BlockedButtonStyle = (
  Default: (
    Background: #6B4E2E(0.06)
  ),
  Hovered: (
    Background: #6B4E2E(0.06)
  ),
  Pressed: (
    Background: #6B4E2E(0.06)
  ),
  Disabled: (
    Background: #6B4E2E(0.06)
  )
);

@TabButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  )
);

@TabLabelStyle = (
  FontSize: 14,
  TextColor: @FubsysRpgInkStrong,
  RenderUppercase: true,
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@CycleCardTitleStyle = (
  FontSize: 12,
  TextColor: @FubsysRpgInkMuted,
  RenderUppercase: true,
  RenderBold: true
);

@CycleActiveTagStyle = (
  FontSize: 12,
  TextColor: @FubsysRpgActiveGreen,
  RenderUppercase: true,
  RenderBold: true
);

@CycleSlotKeyStyle = (
  FontSize: 10,
  TextColor: @FubsysRpgInkMuted,
  RenderUppercase: true,
  RenderBold: true,
  VerticalAlignment: Center
);

@CycleSlotValueStyle = (
  FontSize: 12,
  TextColor: @FubsysRpgInkStrong,
  RenderBold: true,
  VerticalAlignment: Center
);

@CycleSlotButtonStyle = (
  Default: (
    Background: @FubsysRpgPanelShade
  ),
  Hovered: (
    Background: #6B4E2E(0.12)
  ),
  Pressed: (
    Background: #6B4E2E(0.16)
  ),
  Disabled: (
    Background: #6B4E2E(0.06)
  )
);

@SkillNodeButtonStyle = (
  Default: (
    Background: #000000(0.0)
  ),
  Hovered: (
    Background: #000000(0.0)
  ),
  Pressed: (
    Background: #000000(0.0)
  ),
  Disabled: (
    Background: #000000(0.0)
  )
);


@SkillNodeSlotStyle = (
  Default: (
    Background: #000000(0.0)
  ),
  Hovered: (
    Background: #000000(0.0)
  ),
  Pressed: (
    Background: #000000(0.0)
  ),
  Disabled: (
    Background: #000000(0.0)
  )
);

@FubsysRpgPageWidth = 1376;
@FubsysRpgPageHeight = 904;
@FubsysRpgPagePadding = 36;

Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  Background: @FubsysRpgBackdrop;
  LayoutMode: Middle;

  Group {
    Anchor: (Width: @FubsysRpgPageWidth, Height: @FubsysRpgPageHeight);
    Background: PatchStyle(TexturePath: "Common/ContainerFullPatch.png", Border: 20);
    LayoutMode: Full;

    // Jewelry frame (9-slice textures): real pixel-art filigree + transparent center.
    Group #FiligreeBorder {
      Visible: false;
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      Background: #000000(0.0);

      // Frame rail + separate ornate corner sprites (baroque leaf + scroll).
      // All images use AssetPath set from the server (matches the working pattern you provided).
      AssetImage #FrameRail {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      }

      // Corner cast shadows (offset +2,+3).
      AssetImage #CornerFlourishShadowTL { Anchor: (Left: -10, Top: -13, Width: 128, Height: 128); }
      AssetImage #CornerFlourishShadowTR { Anchor: (Right: -10, Top: -13, Width: 128, Height: 128); }
      AssetImage #CornerFlourishShadowBL { Anchor: (Left: -10, Bottom: -19, Width: 128, Height: 128); }
      AssetImage #CornerFlourishShadowBR { Anchor: (Right: -10, Bottom: -19, Width: 128, Height: 128); }

      // Corner flourishes (allow outward protrusion; overlap inward stays limited in the sprite art).
      AssetImage #CornerFlourishTL { Anchor: (Left: -8, Top: -16, Width: 128, Height: 128); }
      AssetImage #CornerFlourishTR { Anchor: (Right: -8, Top: -16, Width: 128, Height: 128); }
      AssetImage #CornerFlourishBL { Anchor: (Left: -8, Bottom: -16, Width: 128, Height: 128); }
      AssetImage #CornerFlourishBR { Anchor: (Right: -8, Bottom: -16, Width: 128, Height: 128); }
    }
    Group #PageContent {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      Padding: (Full: @FubsysRpgPagePadding);
      LayoutMode: Top;


    Group {
      FlexWeight: 1;
      Anchor: (Top: 12);
      LayoutMode: Top;

      Group #Tabs {
        LayoutMode: Left;
        Anchor: (Height: 34);

        Button #TabCharacterButton {
          Anchor: (Width: 140, Height: 30);
          Style: @TabButtonStyle;

          Group #TabCharacterUnderline {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: @FubsysRpgSelectedButtonFill;
            Visible: true;
          }

          Label {
            Style: @TabLabelStyle;
            Text: "Personnage";
          }
        }

        Group { Anchor: (Width: 10); }

        Button #TabSkillsButton {
          Anchor: (Width: 140, Height: 30);
          Style: @TabButtonStyle;

          Group #TabSkillsUnderline {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: @FubsysRpgSelectedButtonFill;
            Visible: false;
          }

          Label {
            Style: @TabLabelStyle;
            Text: "Talents";
          }
        }
        Group { Anchor: (Width: 10); }

        Button #TabArtisansButton {
          Anchor: (Width: 140, Height: 30);
          Style: @TabButtonStyle;

          Group #TabArtisansUnderline {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: @FubsysRpgSelectedButtonFill;
            Visible: false;
          }

          Label {
            Style: @TabLabelStyle;
            Text: "Artisans";
          }
        }

        Group { Anchor: (Width: 10); }

        Button #TabClassementButton {
          Anchor: (Width: 140, Height: 30);
          Style: @TabButtonStyle;

          Group #TabClassementUnderline {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Background: @FubsysRpgSelectedButtonFill;
            Visible: false;
          }

          Label {
            Style: @TabLabelStyle;
            Text: "Classement";
          }
        }


      }

      Group #CharacterTabContent {
        LayoutMode: Top;
        FlexWeight: 1;
        Visible: true;
        Anchor: (Top: 8);

        Group {
          FlexWeight: 1;
          LayoutMode: Full;
          Background: @FubsysRpgPanelShade;
          Padding: (Full: 12);

          Group #CharacterTabMount {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            LayoutMode: Full;
          }
        }
      }

      Group #SkillsTabContent {
        LayoutMode: Left;
        FlexWeight: 1;
        Visible: false;
        Anchor: (Top: 8);

        Group {
          FlexWeight: 1;
          LayoutMode: Full;
          Background: @FubsysRpgPanelShade;
          Padding: (Full: 12);

          Group #SkillsTabMount {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            LayoutMode: Full;
          }
        }
      }

      Group #ArtisansTabContent {
        LayoutMode: Top;
        FlexWeight: 1;
        Visible: false;
        Anchor: (Top: 8);

        Group {
          FlexWeight: 1;
          LayoutMode: Full;
          Background: @FubsysRpgPanelShade;
          Padding: (Full: 12);

          Group #ArtisansTabMount {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            LayoutMode: Full;
          }
        }
      }

      Group #ClassementTabContent {
        LayoutMode: Top;
        FlexWeight: 1;
        Visible: false;
        Anchor: (Top: 8);

        Group {
          FlexWeight: 1;
          LayoutMode: Full;
          Background: @FubsysRpgPanelShade;
          Padding: (Full: 12);

          Group #ClassementTabMount {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            LayoutMode: Full;
          }
        }
      }

    }
    }

    Group #GlobalSkillStatusRow {
      Anchor: (Left: 0, Right: 0, Bottom: 22, Height: 36);
      LayoutMode: Left;
      Visible: false;

      Group { FlexWeight: 1; }

      Group #GlobalSkillStatusStrong {
        Anchor: (Width: 620, Height: 34);
        LayoutMode: Full;
        Background: @FubsysRpgStatusPillBg;
        Padding: (Left: 14, Right: 14, Top: 7, Bottom: 7);
        Visible: false;

        Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 1); Background: @FubsysRpgStatusPillEdge; }
        Label #SkillCastStatusStrong { Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgGoldHighlight, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
      }

      Group #GlobalSkillStatusMedium {
        Anchor: (Width: 620, Height: 34);
        LayoutMode: Full;
        Background: #2B241A(0.26);
        Padding: (Left: 14, Right: 14, Top: 7, Bottom: 7);
        Visible: false;

        Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 1); Background: #D4AF37(0.16); }
        Label #SkillCastStatusMedium { Style: (...@MetaStyle, FontSize: 13, TextColor: #F7E6A5(0.75), RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
      }

      Group #GlobalSkillStatusWeak {
        Anchor: (Width: 620, Height: 34);
        LayoutMode: Full;
        Background: #2B241A(0.14);
        Padding: (Left: 14, Right: 14, Top: 7, Bottom: 7);
        Visible: false;

        Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 1); Background: #D4AF37(0.08); }
        Label #SkillCastStatusWeak { Style: (...@MetaStyle, FontSize: 13, TextColor: #F7E6A5(0.48), RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
      }

      Group { FlexWeight: 1; }
    }
  }
}
