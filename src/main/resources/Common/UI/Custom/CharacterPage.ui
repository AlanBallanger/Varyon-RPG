        Group { Anchor: (Width: 16); }

        Group {
          Anchor: (Width: 420);
          LayoutMode: Top;
          Background: @FubsysRpgPanelShade;
          Padding: (Full: 12);

          Label {
            Style: @SectionTitleStyle;
            Text: "Skill";
          }

          Label #SkillTreeSelectedTitle {
            Anchor: (Top: 10);
            Style: (...@SubHeadingStyle, FontSize: 22, TextColor: @FubsysRpgInkStrong, RenderBold: true);
            Text: "";
          }

          Group #SkillTreeSelectedDescriptionGroup {
            LayoutMode: Top;
            Anchor: (Top: 6);

            Label #SkillTreeSelectedDescriptionLine0 { Style: @MetaStyle; Text: ""; Visible: false; }
            Label #SkillTreeSelectedDescriptionLine1 { Anchor: (Top: 2); Style: @MetaStyle; Text: ""; Visible: false; }
            Label #SkillTreeSelectedDescriptionLine2 { Anchor: (Top: 2); Style: @MetaStyle; Text: ""; Visible: false; }
            Label #SkillTreeSelectedDescriptionLine3 { Anchor: (Top: 2); Style: @MetaStyle; Text: ""; Visible: false; }
            Label #SkillTreeSelectedDescriptionLine4 { Anchor: (Top: 2); Style: @MetaStyle; Text: ""; Visible: false; }
            Label #SkillTreeSelectedDescriptionLine5 { Anchor: (Top: 2); Style: @MetaStyle; Text: ""; Visible: false; }
          }

          Label #SkillTreeSelectedStatus {
            Anchor: (Top: 10);
            Style: (...@MetaStyle, FontSize: 14, TextColor: @FubsysRpgInkMuted);
            Text: "";
          }

          Group { FlexWeight: 1; }

          Group {
            LayoutMode: Full;
            Anchor: (Top: 10, Height: 28);

            Button #UnlockSkillTreeButton {
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Style: @PlusButtonStyle;
              Visible: false;

              Label #UnlockSkillTreeButtonLabel {
                Style: (...@MetaStyle, FontSize: 14, TextColor: @FubsysRpgInkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "Unlock";
              }
            }

            Button #UnlockSkillTreeButtonDisabled {
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Style: @BlockedButtonStyle;
              TextTooltipStyle: (MaxWidth: 340, LabelStyle: (FontSize: 13, Wrap: true));
              TooltipText: "";
              Visible: false;

              Label #UnlockSkillTreeButtonDisabledLabel {
                Style: (...@MetaStyle, FontSize: 14, TextColor: @FubsysRpgInkMuted, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
                Text: "Unlocked";
              }
            }
          }

        }
      }
    }
    }

    Group #GlobalSkillStatusRow {
      Anchor: (Left: 0, Right: 0, Bottom: 22, Height: 36);
      LayoutMode: Left;
      Visible: false;

      Group { FlexWeight: 1; }

      Group #GlobalSkillStatusStrong {
        Anchor: (Width: 620, Height: 34);
        LayoutMode: Full;
        Background: @FubsysRpgStatusPillBg;
        Padding: (Left: 14, Right: 14, Top: 7, Bottom: 7);
        Visible: false;

        Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 1); Background: @FubsysRpgStatusPillEdge; }
        Label #SkillCastStatusStrong { Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgGoldHighlight, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
      }

      Group #GlobalSkillStatusMedium {
        Anchor: (Width: 620, Height: 34);
        LayoutMode: Full;
        Background: #2B241A(0.26);
        Padding: (Left: 14, Right: 14, Top: 7, Bottom: 7);
        Visible: false;

        Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 1); Background: #D4AF37(0.16); }
        Label #SkillCastStatusMedium { Style: (...@MetaStyle, FontSize: 13, TextColor: #F7E6A5(0.75), RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
      }

      Group #GlobalSkillStatusWeak {
        Anchor: (Width: 620, Height: 34);
        LayoutMode: Full;
        Background: #2B241A(0.14);
        Padding: (Left: 14, Right: 14, Top: 7, Bottom: 7);
        Visible: false;

        Group { Anchor: (Left: 0, Right: 0, Top: 0, Height: 1); Background: #D4AF37(0.08); }
        Label #SkillCastStatusWeak { Style: (...@MetaStyle, FontSize: 13, TextColor: #F7E6A5(0.48), RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: ""; }
      }

      Group { FlexWeight: 1; }
    }
  }
