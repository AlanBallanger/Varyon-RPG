          LayoutMode: Middle;
          Label {
            Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true,
              HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "Reconversion";
          }
        }
      }


      Group #ProfessionAboutBox {
        Anchor: (Top: 14, Height: 208);
        LayoutMode: Top;
        Padding: (Full: 12);
        Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8);

        Label #ProfessionAboutTitle {
          Anchor: (Height: 24);
          Style: (FontSize: 14, TextColor: #C8A96E, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Center);
          Text: "À PROPOS DES MÉTIERS";
        }

        Group { Anchor: (Height: 8); }

        Group #ProfessionAboutBody {
          LayoutMode: Top;

          Label #ProfessionAboutBullet0 {
            Anchor: (Left: 0, Right: 0, Height: 38);
            Style: (FontSize: 12, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
            Text: "- Sélectionnez 2 métiers actifs parmi les 8 disponibles.";
          }

          Label #ProfessionAboutBullet1 {
            Anchor: (Left: 0, Right: 0, Height: 38);
            Style: (FontSize: 12, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
            Text: "- Gagnez de l’XP en réalisant des actions liées à vos métiers.";
          }

          Label #ProfessionAboutBullet2 {
            Anchor: (Left: 0, Right: 0, Height: 38);
            Style: (FontSize: 12, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
            Text: "- Montez de niveau pour obtenir des points de talent dans l’arbre dédié à chaque métier.";
          }

          Label #ProfessionAboutBullet3 {
            Anchor: (Left: 0, Right: 0, Height: 38);
            Style: (FontSize: 12, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
            Text: "- Changez de métier avec un temps de recharge de 12 heures.";
          }
        }
      }

    }

    Group { Anchor: (Width: 14, Top: 0, Bottom: 0); }

    Group {
