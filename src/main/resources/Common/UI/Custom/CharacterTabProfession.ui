// Metiers tab - aucun alias @ partage avec CharacterPage (eviter collision merge).

@ProfessionTabSecondaryButton = (
  Default: (
    Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: (TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: (TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: (TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  )
);


Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Label #ProfessionMainTitle {
    Anchor: (Top: 0);
    Style: (FontSize: 22, TextColor: #E8DCC8, RenderBold: true);
    Text: "MES METIERS";
  }

  Group {
    Anchor: (Left: 0, Right: 0, Top: 12, Bottom: 0);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 320, Top: 0, Bottom: 0);
      LayoutMode: Top;

      Label #ProfessionSectionSubtitle {
        Style: (FontSize: 13, TextColor: #C8BEB0, RenderBold: true);
        Text: "";
      }

      Group #ProfessionActiveCard0 {
        Anchor: (Top: 8, Height: 128);
        LayoutMode: Full;
        Padding: (Full: 10);
        Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8);

        Label #ProfessionActiveCard0Name {
          Anchor: (Left: 0, Right: 0, Top: 0, Height: 24);
          Style: (FontSize: 18, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center);
          Text: "";
        }

        Label #ProfessionActiveCard0Level {
          Anchor: (Left: 0, Right: 0, Top: 28, Height: 20);
          Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center);
          Text: "";
        }

        Button #ProfessionActiveCard0Reconvert {
          Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 28);
          Style: @ProfessionTabSecondaryButton;
          LayoutMode: Middle;
          Label {
            Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true,
              HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "Reconversion";
          }
        }
      }

      Group { Anchor: (Top: 10, Height: 10); }

      Group #ProfessionActiveCard1 {
        Anchor: (Top: 0, Height: 128);
        LayoutMode: Full;
        Padding: (Full: 10);
        Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8);

        Label #ProfessionActiveCard1Name {
          Anchor: (Left: 0, Right: 0, Top: 0, Height: 24);
          Style: (FontSize: 18, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center);
          Text: "";
        }

        Label #ProfessionActiveCard1Level {
          Anchor: (Left: 0, Right: 0, Top: 28, Height: 20);
          Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center);
          Text: "";
        }

        Button #ProfessionActiveCard1Reconvert {
          Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 28);
