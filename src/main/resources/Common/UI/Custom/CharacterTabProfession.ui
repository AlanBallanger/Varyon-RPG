$C = "Common.ui";

@ProfessionTabViewTalentsButton = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  ),
  Sounds: $C.@ButtonSounds
);

@ProfessionTabSecondaryButton = (
  Default: (
    Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: (TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: (TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: (TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  ),
  Sounds: $C.@ButtonSounds
);


Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Group {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 320, Top: 0, Bottom: 0);
      LayoutMode: Top;

      Group {
        Anchor: (Height: 24);
        LayoutMode: Left;
        Group { Anchor: (Width: 20, Height: 20); Background: PatchStyle(TexturePath: "Elements/Crown.png", Border: 0); }
        Group { Anchor: (Width: 6); }
        Label {
          Style: (FontSize: 21, TextColor: #C8A96E, RenderBold: true, HorizontalAlignment: Start, RenderUppercase: true);
          Text: "Métier principal";
        }
        Group { Anchor: (Width: 10); }
        Label {
          Style: (FontSize: 14, TextColor: #6BCB7A, RenderBold: true, VerticalAlignment: Center);
          Text: "(100% XP)";
        }
      }

      Group #ProfessionActiveCard0 {
        Anchor: (Top: 8, Height: 150);
        LayoutMode: Full;
        Padding: (Full: 10);
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

        Group {
          LayoutMode: Full;
          Anchor: (Left: 0, Right: 0, Top: 0, Height: 70);

          Group {
            Anchor: (Left: 0, Top: 0, Width: 60, Height: 60);
            LayoutMode: Full;
            Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 6, Color: #31C677FF);
            Padding: (Full: 3);

            Group {
              LayoutMode: Middle;
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Background: #141820(0.82);

              ItemIcon #ProfessionActiveCard0Icon {
                Anchor: (Width: 48, Height: 48);
              }
            }
          }

          Label #ProfessionActiveCard0Name {
            Anchor: (Left: 70, Right: 0, Top: 0, Height: 36);
            Style: (FontSize: 22, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, HorizontalAlignment: Start);
            Text: "";
          }

          Group {
            Anchor: (Left: 70, Right: 0, Top: 36, Height: 22);
            LayoutMode: Left;

            Group {
              Background: #25793C(1.0);
              Padding: (Horizontal: 6, Vertical: 2);

              Label #ProfessionActiveCard0LevelBadge {
                Style: (FontSize: 11, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center);
                Text: "";
              }
            }

            Group { Anchor: (Width: 8); }

            Label #ProfessionActiveCard0LevelXp {
              Anchor: (Height: 22);
              Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center, HorizontalAlignment: Start);
              Text: "";
            }
          }
        }

        Group #ProfessionActiveCard0ProgBar {
          Anchor: (Left: 0, Right: 0, Top: 72, Bottom: 32);
          Background: PatchStyle(TexturePath: "Elements/Gauge.png", Border: 0);
          ProgressBar #ProfessionActiveCard0ProgBarFill {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Value: 0.0;
            BarTexturePath: "Elements/Gauge_Fill.png";
          }
        }

        Group {
          Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 28);
          LayoutMode: Left;

          Button #ProfessionActiveCard0Reconvert {
            FlexWeight: 1;
            Style: @ProfessionTabSecondaryButton;
            LayoutMode: Middle;
            Label {
              Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true,
                HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "Reconversion";
            }
          }

          Group { Anchor: (Width: 4); }

          Button #ProfessionActiveCard0ViewTalents {
            FlexWeight: 1;
            Style: @ProfessionTabViewTalentsButton;
            LayoutMode: Middle;
            Label {
              Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true,
                HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "Voir talents";
            }
          }
        }
      }

      Group {
        Anchor: (Top: 14, Height: 24);
        LayoutMode: Left;
        Group { Anchor: (Width: 20, Height: 20); Background: PatchStyle(TexturePath: "Elements/Star.png", Border: 0); }
        Group { Anchor: (Width: 6); }
        Label {
          Style: (FontSize: 21, TextColor: #C8A96E, RenderBold: true, HorizontalAlignment: Start, RenderUppercase: true);
          Text: "Métier secondaire";
        }
        Group { Anchor: (Width: 10); }
        Label {
          Style: (FontSize: 14, TextColor: #C8A96E, RenderBold: true, VerticalAlignment: Center);
          Text: "(70% XP)";
        }
      }

      Group #ProfessionActiveCard1 {
