          Label #ProfessionCatalogCard0Level {
            Anchor: (Top: 26, Height: 20);
            Style: (FontSize: 13, TextColor: #C8BEB0, VerticalAlignment: Center);
            Text: "";
          }

          Label #ProfessionCatalogCard0Prereq {
            Anchor: (Top: 60, Bottom: 0);
            Style: (FontSize: 11, TextColor: #C8BEB0, VerticalAlignment: Center);
            Text: "";
            Visible: false;
