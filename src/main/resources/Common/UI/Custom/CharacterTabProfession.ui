      Group #ProfessionAboutBox {
        Anchor: (Top: 18, Left: 0, Right: 0);
        LayoutMode: Top;
        Padding: (Full: 12);
        Background: PatchStyle(TexturePath: "Elements/HudPanel.png", Border: 10);

        Group {
          Anchor: (Left: 0, Right: 0, Height: 20);
          LayoutMode: Left;
          Group { Anchor: (Width: 16, Height: 16); Background: PatchStyle(TexturePath: "Icons/Info.png", Border: 0); }
          Group { Anchor: (Width: 8); }
          Label #ProfessionAboutTitle {
            Anchor: (Height: 20);
            Style: (FontSize: 13, TextColor: #C8A96E, RenderUppercase: true, RenderBold: true, VerticalAlignment: Center);
            Text: "À PROPOS DES MÉTIERS";
          }
        }

        Group { Anchor: (Height: 10); }

        Group {
          Anchor: (Left: 0, Right: 0);
          LayoutMode: Left;

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Group {
              Anchor: (Left: 0, Right: 0, Height: 36);
              LayoutMode: Left;
              Group { Anchor: (Width: 24, Height: 24); Background: PatchStyle(TexturePath: "Elements/People.png", Border: 0); }
              Group { Anchor: (Width: 8); }
              Label {
                FlexWeight: 1;
                Anchor: (Height: 36);
                Style: (FontSize: 11, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
                Text: "Sélectionnez 2 métiers actifs parmi les 8 disponibles.";
              }
            }

            Group { Anchor: (Height: 6); }

            Group {
              Anchor: (Left: 0, Right: 0, Height: 36);
              LayoutMode: Left;
              Group { Anchor: (Width: 24, Height: 24); Background: PatchStyle(TexturePath: "Icons/XP.png", Border: 0); }
              Group { Anchor: (Width: 8); }
              Label {
                FlexWeight: 1;
                Anchor: (Height: 36);
                Style: (FontSize: 11, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
                Text: "Gagnez de l'XP en réalisant des actions liées à vos métiers.";
              }
            }
          }

          Group { Anchor: (Width: 24); }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;

            Group {
              Anchor: (Left: 0, Right: 0, Height: 36);
              LayoutMode: Left;
              Group { Anchor: (Width: 24, Height: 24); Background: PatchStyle(TexturePath: "Icons/Talent.png", Border: 0); }
              Group { Anchor: (Width: 8); }
              Label {
                FlexWeight: 1;
                Anchor: (Height: 36);
                Style: (FontSize: 11, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
                Text: "Montez de niveau pour obtenir des points de talents dans l'arbre dédié à chaque métier.";
              }
            }

            Group { Anchor: (Height: 6); }

            Group {
              Anchor: (Left: 0, Right: 0, Height: 36);
              LayoutMode: Left;
              Group { Anchor: (Width: 24, Height: 24); Background: PatchStyle(TexturePath: "Icons/Hourglass.png", Border: 0); }
              Group { Anchor: (Width: 8); }
              Label {
                FlexWeight: 1;
                Anchor: (Height: 36);
                Style: (FontSize: 11, TextColor: #C8BEB0, HorizontalAlignment: Start, VerticalAlignment: Center, Wrap: true);
                Text: "Changez de métier avec un temps de recharge de 12 heures.";
              }
            }
          }
        }
      }

      Group { FlexWeight: 1; }
    }
