// Metiers tab - aucun alias @ partage avec CharacterPage (eviter collision merge).

@ProfessionTabViewTalentsButton = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8, Color: #3B82F6FF)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8, Color: #60A5FAFF)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8, Color: #2563EBFF)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8, Color: #3B82F6(0.40))
  )
);

@ProfessionTabSecondaryButton = (
  Default: (
    Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: (TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: (TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: (TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  )
);


Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Label #ProfessionMainTitle {
    Anchor: (Top: 0);
    Style: (FontSize: 29, TextColor: #E8DCC8, RenderBold: true);
    Text: "MES METIERS";
  }

  Group {
    Anchor: (Left: 0, Right: 0, Top: 12, Bottom: 0);
    LayoutMode: Left;

    Group {
      Anchor: (Width: 320, Top: 0, Bottom: 0);
      LayoutMode: Top;

      Label {
        Style: (FontSize: 14, TextColor: #C8BEB0, RenderBold: true, HorizontalAlignment: Start, RenderUppercase: true);
        Text: "Métier principal";
      }

      Group #ProfessionActiveCard0 {
        Anchor: (Top: 8, Height: 150);
        LayoutMode: Full;
        Padding: (Full: 10);
        Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Left: 0, Right: 0, Top: 0, Height: 44);

          Group {
            Anchor: (Width: 44, Height: 44);
            LayoutMode: Full;
            Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 6);
            Padding: (Full: 3);

            Group {
              LayoutMode: Middle;
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Background: #141820(0.82);

              ItemIcon #ProfessionActiveCard0Icon {
                Anchor: (Width: 32, Height: 32);
              }
            }
          }

          Group { Anchor: (Width: 10); }

          Label #ProfessionActiveCard0Name {
            FlexWeight: 1;
            Anchor: (Height: 44);
            Style: (FontSize: 23, TextColor: #F2E8D8, RenderBold: true, RenderUppercase: true, VerticalAlignment: Center, HorizontalAlignment: Start);
            Text: "";
          }
        }

        Group {
          Anchor: (Left: 0, Right: 0, Bottom: 44, Height: 26);
          LayoutMode: Left;

          Group {
            Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 4);
            Padding: (Full: 2);

            Group {
              Background: #31C677(1.0);
              Padding: (Horizontal: 6, Vertical: 2);

              Label #ProfessionActiveCard0LevelBadge {
                Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, VerticalAlignment: Center);
                Text: "";
              }
            }
          }

          Group { Anchor: (Width: 8); }

          Label #ProfessionActiveCard0LevelXp {
            Anchor: (Height: 26);
            Style: (FontSize: 14, TextColor: #C8BEB0, VerticalAlignment: Center, HorizontalAlignment: Start);
            Text: "";
          }
        }

        Group #ProfessionActiveCard0ProgBar {
          Anchor: (Left: 14, Right: 14, Bottom: 28, Height: 20);
          Background: PatchStyle(TexturePath: "Elements/Gauge.png", Border: 0);
          ProgressBar #ProfessionActiveCard0ProgBarFill {
            Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
            Value: 0.0;
            BarTexturePath: "Elements/Gauge_Fill.png";
          }
        }

        Group {
          Anchor: (Left: 0, Right: 0, Bottom: 0, Height: 28);
          LayoutMode: Left;

          Button #ProfessionActiveCard0Reconvert {
            FlexWeight: 1;
            Style: @ProfessionTabSecondaryButton;
            LayoutMode: Middle;
            Label {
              Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true,
                HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "Reconversion";
            }
          }

          Group { Anchor: (Width: 4); }

          Button #ProfessionActiveCard0ViewTalents {
            FlexWeight: 1;
            Style: @ProfessionTabViewTalentsButton;
            LayoutMode: Middle;
            Label {
              Style: (FontSize: 14, TextColor: #FFFFFF, RenderBold: true,
                HorizontalAlignment: Center, VerticalAlignment: Center);
              Text: "Voir talents";
            }
          }
        }
      }

      Label {
        Anchor: (Top: 14);
        Style: (FontSize: 14, TextColor: #C8BEB0, RenderBold: true, HorizontalAlignment: Start, RenderUppercase: true);
        Text: "Métier secondaire";
      }

      Group #ProfessionActiveCard1 {
        Anchor: (Top: 0, Height: 150);
        LayoutMode: Full;
        Padding: (Full: 10);
        Background: (TexturePath: "Common/Buttons/Tertiary.png", Border: 8);

        Group {
          LayoutMode: Left;
          Anchor: (Left: 0, Right: 0, Top: 0, Height: 44);

          Group {
            Anchor: (Width: 44, Height: 44);
