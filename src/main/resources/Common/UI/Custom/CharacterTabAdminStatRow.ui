Group {
  Anchor: (Left: 0, Right: 0, Height: 22);
  LayoutMode: Full;

  Label #AdminStatRowName {
    Anchor: (Left: 0, Width: 140, Top: 0, Bottom: 0);
    Style: (FontSize: 12, TextColor: #C8BEB0, VerticalAlignment: Center);
    Text: "";
  }

  Label #AdminStatRowLevel {
    Anchor: (Left: 148, Right: 0, Top: 0, Bottom: 0);
    Style: (FontSize: 12, TextColor: #F2E8D8, RenderBold: true, VerticalAlignment: Center);
