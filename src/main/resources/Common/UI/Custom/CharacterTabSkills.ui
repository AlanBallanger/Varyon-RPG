  Group { Anchor: (Width: 16); }

  Group {
    Anchor: (Top: 0, Bottom: 0, Width: 290);
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8, Color: #FFD700FF);
    Padding: (Full: 5);

    Group {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      LayoutMode: Top;
      Background: @FubsysRpgPanelShade;
      Padding: (Full: 10);

      Label {
        Style: @SectionTitleStyle;
        Text: "Talent";
      }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 10);

        Group #SkillSidebarIcon {
          Anchor: (Width: 52, Height: 52);
          Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8, Color: #31C677FF);

          Group #SkillSidebarIconImage {
            Anchor: (Left: 4, Top: 4, Right: 4, Bottom: 4);
          }
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Left: 10);

          Label #SkillTreeSelectedTitle {
            Style: (...@SubHeadingStyle, FontSize: 16, TextColor: @FubsysRpgInkStrong, RenderBold: true, Wrap: true);
            Text: "";
          }

          Label #SkillTreeSelectedFlavor {
            Anchor: (Top: 4);
            Style: (...@MetaStyle, FontSize: 12, TextColor: @FubsysRpgInkFaint, Wrap: true);
            Text: "";
          }
        }
      }

      Label #SkillTreeSelectedEffect {
        Anchor: (Top: 10);
        Style: (...@MetaStyle, FontSize: 14, TextColor: #FFFFFFFF, Wrap: true);
        Text: "";
      }

      Group { Anchor: (Top: 10, Height: 1); Background: @FubsysRpgDivider; }

      Group {
        LayoutMode: Left;
        Anchor: (Top: 8);

        Label {
          Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgInkMuted, RenderBold: true);
          Text: "Niveau actuel";
        }

        Group { FlexWeight: 1; }

        Label #SkillTreeCurrentRankValue {
          Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgInkStrong, RenderBold: true);
          Text: "0/5";
        }
      }

      Group #SkillTreeCurrentBonusRow {
        LayoutMode: Left;
        Anchor: (Top: 4);
        Visible: false;

        Label {
          Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgInkMuted, RenderBold: true);
          Text: "Bonus actuel";
        }

        Group { FlexWeight: 1; }

        Label #SkillTreeCurrentBonusValue {
          Style: (...@MetaStyle, FontSize: 13, TextColor: #31C677FF, RenderBold: true, Wrap: true);
          Text: "";
        }
      }

      Group #SkillTreeNextRankRow {
        LayoutMode: Left;
        Anchor: (Top: 4);
        Visible: false;

        Label {
          Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgInkMuted, RenderBold: true);
          Text: "Prochain rang";
        }

        Group { FlexWeight: 1; }

        Label #SkillTreeNextRankValue {
          Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgGoldHighlight, RenderBold: true, Wrap: true);
          Text: "";
        }
      }

      Label #SkillTreeTypePassif { Anchor: (Top: 8); Style: (...@MetaStyle, FontSize: 13, TextColor: #6BCB7AFF, RenderBold: true, RenderUppercase: true); Text: "Passif"; Visible: false; }
      Label #SkillTreeTypeActif  { Anchor: (Top: 8); Style: (...@MetaStyle, FontSize: 13, TextColor: #D4AF37FF, RenderBold: true, RenderUppercase: true); Text: "Actif";  Visible: false; }
      Label #SkillTreeTypeObjet  { Anchor: (Top: 8); Style: (...@MetaStyle, FontSize: 13, TextColor: #FFFFFFFF, RenderBold: true, RenderUppercase: true); Text: "Objet";  Visible: false; }

      Group { FlexWeight: 1; }

      Group {
        LayoutMode: Full;
        Anchor: (Top: 10, Height: 28);

        Button #UnlockSkillTreeButton {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Style: @PlusButtonStyle;
          Visible: false;

          Label #UnlockSkillTreeButtonLabel {
            Style: (...@MetaStyle, FontSize: 14, TextColor: @FubsysRpgInkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "Débloquer";
          }
        }

        Button #UnlockSkillTreeButtonDisabled {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Style: @BlockedButtonStyle;
          TextTooltipStyle: (MaxWidth: 340, LabelStyle: (FontSize: 13, Wrap: true));
          TooltipText: "";
          Visible: false;

          Label #UnlockSkillTreeButtonDisabledLabel {
            Style: (...@MetaStyle, FontSize: 14, TextColor: @FubsysRpgInkMuted, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "Débloqué";
          }
        }
      }
    }
  }
}
