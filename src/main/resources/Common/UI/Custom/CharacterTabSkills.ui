$C = "Common.ui";

@FubsysRpgInk = #E8DCC8;
@FubsysRpgInkStrong = #F2E8D8;
@FubsysRpgInkMuted = #C8BEB0;
@FubsysRpgInkFaint = #A89E90;
@FubsysRpgLeatherBg = #000000(0.22);
@FubsysRpgPanelShade = #000000(0.32);
@FubsysRpgCardShade = #000000(0.26);
@FubsysRpgGold = #D4AF37(0.92);
@FubsysRpgGoldSoft = #D4AF37(0.74);
@FubsysRpgGoldHighlight = #F7E6A5(0.62);
@FubsysRpgGoldShadow = #1A1612(0.55);
@FubsysRpgActiveGreen = #6BCB7A(0.95);
@FubsysRpgAging = #8A7A5A(0.22);
@FubsysRpgParchmentMottle = #FFFFFF(0.03);
@FubsysRpgGrainLight = #FFFFFF(0.02);
@FubsysRpgGrainDark = #000000(0.12);
@FubsysRpgEdge1 = #FFFFFF(0.05);
@FubsysRpgEdge2 = #FFFFFF(0.03);
@FubsysRpgEdge3 = #000000(0.20);
@FubsysRpgDivider = #E8DCC8(0.16);
@FubsysRpgDividerSoft = #E8DCC8(0.10);
@FubsysRpgBackdrop = #000000(0.42);
@FubsysRpgSelectedButtonFill = #D4AF37(0.38);
@FubsysRpgStatusPillBg = #000000(0.40);
@FubsysRpgStatusPillEdge = #D4AF37(0.35);
@FubsysRpgSkillTreeEdgeGlow = #D4AF37(0.62);
@FubsysRpgSkillTreeNodeGlow = #D4AF37(0.18);

@HeadingStyle = (
  FontSize: 24,
  TextColor: @FubsysRpgInk,
  RenderBold: true
);

@SubHeadingStyle = (
  FontSize: 18,
  TextColor: @FubsysRpgInkStrong,
  RenderBold: true
);

@MetaStyle = (
  FontSize: 16,
  TextColor: @FubsysRpgInkMuted
);

@SectionTitleStyle = (
  FontSize: 16,
  TextColor: #C8A96E,
  RenderUppercase: true,
  RenderBold: true
);

@StatLabelStyle = (
  FontSize: 16,
  TextColor: #B8A88C,
  RenderUppercase: true
);

@ReadableStatLabelStyle = (
  ...@StatLabelStyle,
  RenderUppercase: false
);

@StatValueStyle = (
  FontSize: 18,
  TextColor: @FubsysRpgInkStrong,
  RenderBold: true
);

@PlusButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  )
);

@BlockedButtonStyle = (
  Default: (
    Background: #6B4E2E(0.06)
  ),
  Hovered: (
    Background: #6B4E2E(0.06)
  ),
  Pressed: (
    Background: #6B4E2E(0.06)
  ),
  Disabled: (
    Background: #6B4E2E(0.06)
  )
);

@TabButtonStyle = (
  Default: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8)
  ),
  Hovered: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Hovered.png", Border: 8)
  ),
  Pressed: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary_Pressed.png", Border: 8)
  ),
  Disabled: (
    Background: PatchStyle(TexturePath: "Common/Buttons/Disabled.png", Border: 8)
  )
);

@TabLabelStyle = (
  FontSize: 14,
  TextColor: @FubsysRpgInkStrong,
  RenderUppercase: true,
  RenderBold: true,
  HorizontalAlignment: Center,
  VerticalAlignment: Center
);

@CycleCardTitleStyle = (
  FontSize: 12,
  TextColor: @FubsysRpgInkMuted,
  RenderUppercase: true,
  RenderBold: true
);

@CycleActiveTagStyle = (
  FontSize: 12,
  TextColor: @FubsysRpgActiveGreen,
  RenderUppercase: true,
  RenderBold: true
);

@CycleSlotKeyStyle = (
  FontSize: 10,
  TextColor: @FubsysRpgInkMuted,
  RenderUppercase: true,
  RenderBold: true,
  VerticalAlignment: Center
);

@CycleSlotValueStyle = (
  FontSize: 12,
  TextColor: @FubsysRpgInkStrong,
  RenderBold: true,
  VerticalAlignment: Center
);

@CycleSlotButtonStyle = (
  Default: (
    Background: @FubsysRpgPanelShade
  ),
  Hovered: (
    Background: #6B4E2E(0.12)
  ),
  Pressed: (
    Background: #6B4E2E(0.16)
  ),
  Disabled: (
    Background: #6B4E2E(0.06)
  )
);

@SkillNodeButtonStyle = (
  Default: (
    Background: #000000(0.0)
  ),
  Hovered: (
    Background: #000000(0.0)
  ),
  Pressed: (
    Background: #000000(0.0)
  ),
  Disabled: (
    Background: #000000(0.0)
  )
);


@SkillNodeSlotStyle = (
  Default: (
    Background: #000000(0.0)
  ),
  Hovered: (
    Background: #000000(0.0)
  ),
  Pressed: (
    Background: #000000(0.0)
  ),
  Disabled: (
    Background: #000000(0.0)
  )
);

@FubsysRpgPageWidth = 1170;
@FubsysRpgPageHeight = 768;
@FubsysRpgPagePadding = 31;


Group {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Left;

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

  Group {
    LayoutMode: Left;
    Anchor: (Left: 0, Right: 0, Height: 48);
    Padding: (Left: 8, Top: 2, Right: 8);

    Group {
      LayoutMode: Top;

      Label {
        Style: @SectionTitleStyle;
        Text: "Arbre de talents";
      }

      Label #SkillTreePointsValue {
        Anchor: (Top: 2);
        Style: (...@MetaStyle, FontSize: 13, TextColor: @FubsysRpgInkMuted, RenderBold: true);
        Text: "Points restants : 0";
      }
    }

    Group { FlexWeight: 1; }

    Group #SkillTreeProfessionPickerRow {
      LayoutMode: Left;
      Visible: false;

      Button #SkillTreeTalentSlot0Button {
        Anchor: (Right: 8, Width: 112, Height: 26);
        Style: @CycleSlotButtonStyle;
        Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8, Color: #E2B161FF);
        LayoutMode: Middle;
        Label #SkillTreeTalentSlot0ButtonLabel {
          Style: (FontSize: 12, TextColor: @FubsysRpgInkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "-";
        }
      }

      Button #SkillTreeTalentSlot1Button {
        Anchor: (Right: 8, Width: 112, Height: 26);
        Style: @CycleSlotButtonStyle;
        Background: PatchStyle(TexturePath: "Common/Buttons/Tertiary.png", Border: 8, Color: #E2B161FF);
        LayoutMode: Middle;
        Label #SkillTreeTalentSlot1ButtonLabel {
          Style: (FontSize: 12, TextColor: @FubsysRpgInkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "-";
        }
      }
    }
  }

    Group #SkillTreeCanvas {
      FlexWeight: 1;
      LayoutMode: Full;

      Group #SkillTreePager {
        Anchor: (Right: 0, Top: 0, Width: 64, Height: 90);
        LayoutMode: Full;
        Background: @FubsysRpgPanelShade;
        Padding: (Full: 6);
        Visible: false;

        Button #SkillTreePageUpButton {
          Anchor: (Left: 6, Right: 6, Top: 6, Height: 22);
          Style: @PlusButtonStyle;

          Label {
            Style: (FontSize: 16, TextColor: @FubsysRpgInkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "^";
          }
        }

        Label #SkillTreePageLabel {
          Anchor: (Left: 0, Right: 0, Top: 37, Height: 16);
          Style: (...@MetaStyle, FontSize: 12, HorizontalAlignment: Center);
          Text: "";
        }

        Button #SkillTreePageDownButton {
          Anchor: (Left: 6, Right: 6, Bottom: 6, Height: 22);
          Style: @PlusButtonStyle;

          Label {
            Style: (FontSize: 16, TextColor: @FubsysRpgInkStrong, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
            Text: "v";
          }
        }
      }

      Group #SkillTreeSpecializationWipRect { Anchor: (Left: 0, Top: 0, Width: 720, Height: 34); Background: @FubsysRpgCardShade; Visible: false; }
      Label #SkillTreeSpecializationWipLabel { Anchor: (Left: 0, Top: 0, Width: 720, Height: 34); Style: (...@MetaStyle, FontSize: 14, TextColor: @FubsysRpgInkMuted, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Spécialisation (à venir)"; Visible: false; }

      Button #SkillTreeAttribuerButton { Anchor: (Right: 8, Top: 4, Width: 118, Height: 28); Style: @PlusButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 13, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Attribuer"; }
      }
      Button #SkillTreeResetButton { Anchor: (Right: 8, Bottom: 8, Width: 88, Height: 26); Style: @PlusButtonStyle; LayoutMode: Middle;
        Label { Style: (FontSize: 12, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); Text: "Réinitialiser"; }
      }


      Group #SkillTreeEdgeRootStem { Anchor: (Left: 390, Top: 134, Width: 4, Height: 16); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeRootBranch { Anchor: (Left: 152, Top: 150, Width: 480, Height: 4); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeRootToNode6 { Anchor: (Left: 150, Top: 150, Width: 4, Height: 10); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeRootToNode7 { Anchor: (Left: 310, Top: 150, Width: 4, Height: 10); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeRootToNode1 { Anchor: (Left: 470, Top: 150, Width: 4, Height: 10); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeRootToNode2 { Anchor: (Left: 630, Top: 150, Width: 4, Height: 10); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeNode6ToNode9 { Anchor: (Left: 150, Top: 224, Width: 4, Height: 46); Background: @FubsysRpgDivider; Visible: false; }
      Group #SkillTreeEdgeNode2ToNode8 { Anchor: (Left: 630, Top: 224, Width: 4, Height: 46); Background: @FubsysRpgDivider; Visible: false; }

      Group #SkillTreeEdgeSeg0 { Anchor: (Left: 0, Top: 0, Width: 4, Height: 4); Background: @FubsysRpgDivider; Visible: false; }
